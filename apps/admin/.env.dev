# `vite build --mode dev`: the Cloudflare dev environment.
CLOUDFLARE_ENV=dev
# The dev app address
VITE_APP_URL=https://dev.project180.co.za

# Cloudflare Turnstile: the DEV widget's site key ("Project 180 dev": dev.project180.co.za,
# admin-dev.project180.co.za). Its secret: bunx wrangler secret put TURNSTILE_SECRET_KEY --env dev
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAGF0QqtK7wQFCH29
