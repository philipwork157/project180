{
  "name": "@project180/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "e2e": "playwright test",
    "deploy": "wrangler deploy",
    "build:dev": "vite build --mode dev",
    "deploy:dev": "vite build --mode dev && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply project180-db --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply project180-db --remote",
    "db:migrate:dev": "wrangler d1 migrations apply project180-db-dev --remote --env dev"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "@project180/client": "workspace:*",
    "@project180/shared": "workspace:*",
    "@project180/ui": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "better-auth": "^1.7.18",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@project180/api": "workspace:*",
    "@project180/config": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.167.43",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.159.0"
  }
}
