{
  "name": "project180",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@project180/app --filter=@project180/admin",
    "dev:app": "turbo run dev --filter=@project180/app",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=@project180/app --filter=@project180/admin --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "db:generate": "bun run --filter @project180/db generate",
    "db:migrate": "bun run --filter @project180/app db:migrate:local",
    "db:apply": "bun run db:generate && bun run db:migrate",
    "db:dev:apply": "bun run db:generate && bun run db:migrate:dev",
    "admin:create": "bun packages/api/scripts/create-admin.ts",
    "admin:create:dev": "bun packages/api/scripts/create-admin.ts --dev",
    "admin:create:live": "bun packages/api/scripts/create-admin.ts --live",
    "db:seed": "bun packages/db/scripts/seed-library.ts",
    "db:seed:remote": "bun packages/db/scripts/seed-library.ts --remote",
    "deploy": "bun scripts/check-live.ts && bun run db:migrate:live && turbo run deploy --filter=@project180/app --filter=@project180/admin",
    "deploy:dev": "bun run db:migrate:dev && turbo run deploy:dev --filter=@project180/app --filter=@project180/admin",
    "db:migrate:dev": "bun run --filter @project180/app db:migrate:dev",
    "db:migrate:live": "bun run --filter @project180/app db:migrate:remote",
    "db:seed:dev": "bun packages/db/scripts/seed-library.ts --env dev",
    "db:recipes": "bun packages/db/scripts/seed-recipes.ts",
    "db:recipes:dev": "bun packages/db/scripts/seed-recipes.ts --env dev",
    "db:recipes:remote": "bun packages/db/scripts/seed-recipes.ts --remote",
    "db:starter": "bun packages/db/scripts/seed-starter-programs.ts",
    "db:starter:dev": "bun packages/db/scripts/seed-starter-programs.ts --env dev",
    "db:starter:remote": "bun packages/db/scripts/seed-starter-programs.ts --remote",
    "db:philip": "bun packages/db/scripts/seed-philip.ts",
    "db:philip:dev": "bun packages/db/scripts/seed-philip.ts --env dev",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
